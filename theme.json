{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "48rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "bg",
					"color": "#FAF5E8",
					"name": "Background"
				},
				{
					"slug": "bg-card",
					"color": "#F4EBD4",
					"name": "Bg card"
				},
				{
					"slug": "bg-dark",
					"color": "#2E1A0E",
					"name": "Bg dark"
				},
				{
					"slug": "border-base",
					"color": "#EAD9BA",
					"name": "Border"
				},
				{
					"slug": "border-muted",
					"color": "#D4B98A",
					"name": "Border muted"
				},
				{
					"slug": "text-strong",
					"color": "#2E1A0E",
					"name": "Text (strong)"
				},
				{
					"slug": "text-muted",
					"color": "#6A5E51",
					"name": "Muted text"
				},
				{
					"slug": "text-faint",
					"color": "#756857",
					"name": "Text faint"
				},
				{
					"slug": "text-light",
					"color": "#FAF5E8",
					"name": "Text light"
				},
				{
					"slug": "accent",
					"color": "#B24A1B",
					"name": "Accent"
				},
				{
					"slug": "accent-dark",
					"color": "#B8441A",
					"name": "Accent dark"
				},
				{
					"slug": "accent-light",
					"color": "#E8845A",
					"name": "Accent light"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Fraunces",
					"slug": "display",
					"fontFamily": "\"Fraunces\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-latin-700-normal.woff2"
							]
						}
					]
				},
				{
					"name": "Plus Jakarta Sans",
					"slug": "body",
					"fontFamily": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/plus-jakarta-sans-latin-700-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3rem"
					}
				},
				{
					"slug": "huge",
					"name": "Display",
					"size": "4.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--text-strong)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4vw, 2.5rem)",
				"right": "clamp(1.25rem, 4vw, 2.5rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--text-strong)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-dark)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--bg)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "0.02em"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-dark)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"width": "2px",
							"color": "var(--wp--preset--color--accent)"
						},
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--accent-dark)"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.5rem",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--text-strong)"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [],
	"title": "Slow Pour"
}
